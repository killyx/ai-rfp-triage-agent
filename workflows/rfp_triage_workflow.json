    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Generate a polite decline email explaining our $10,000 USD minimum custom engineering threshold and recommending practical no-code/low-code alternatives (Bubble, Sharetribe, Shopify)."
