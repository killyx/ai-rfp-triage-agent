{
  "name": "Autonomous B2B RFP & Lead Triage Agent (Model Cascading + RAG + HITL)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rfp-ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1f4c001-1111-4000-8000-000000000001",
      "name": "Webhook: Ingest RFP (PDF / Email)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        360
      ],
      "webhookId": "rfp-ingest-webhook-01"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://app:8000/api/triage/text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw_text: $json.body.raw_text || $json.raw_text, source_name: $json.body.source_name || 'n8n_webhook.txt' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b1f4c001-1111-4000-8000-000000000002",
      "name": "FastAPI Service: Parse PDF & Validate Schema",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        430,
        360
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Extract B2B RFP parameters into strict JSON Schema: client_name, company, estimated_budget_usd, timeline_weeks, required_tech_stack, scope_summary, missing_information_flags."
            },
            {
              "role": "user",
              "content": "={{ $json.raw_text }}"
            }
          ]
        },
        "options": {
          "temperature": 0,
          "responseFormat": "json_object"
        }
      },
      "id": "b1f4c001-1111-4000-8000-000000000003",
      "name": "OpenAI Tier-1: Fast Extraction (gpt-4o-mini Structured Outputs)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [
        690,
        360
      ]
    },
    {
      "parameters": {
        "mode": "retrieve",
        "chromaCollection": {
          "__rl": true,
          "value": "apexvector_case_studies",
          "mode": "list"
        },
        "topK": 3,
        "options": {}
      },
      "id": "b1f4c001-1111-4000-8000-000000000004",
      "name": "Vector Store RAG: Retrieve Case Studies & Verify Tech Stack",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreChroma",
      "typeVersion": 1,
      "position": [
        960,
        360
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.scoring.classification }}",
                    "rightValue": "HIGH_FIT",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.scoring.total_score }}",
                    "rightValue": 75,
                    "operator": {
                      "type": "number",
                      "operation": "gt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HIGH_FIT (>75)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.scoring.classification }}",
                    "rightValue": "AMBIGUOUS",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "AMBIGUOUS (Discovery)"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.scoring.classification }}",
                    "rightValue": "LOW_FIT",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "LOW_FIT (<$10k / Mismatch)"
            }
          ]
        },
        "options": {}
      },
      "id": "b1f4c001-1111-4000-8000-000000000005",
      "name": "Switch: Qualification & $10k Policy Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1220,
        360
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a Staff AI Solutions Architect. Generate a tailored B2B commercial proposal with estimated price bands, recommended squad composition, and citations to the top matched RAG case studies."
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json.extraction) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "b1f4c001-1111-4000-8000-000000000006",
      "name": "OpenAI Tier-2: High-Fit Proposal Generator (gpt-4o)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [
        1520,
        160
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Generate a concise discovery clarification email asking the client to specify missing_information_flags (budget envelope, timeline, ERP scope) while citing relevant logistics/AI case studies."
            },
            {
              "role": "user",
              "content": "={{ JSON.stringify($json.extraction) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "b1f4c001-1111-4000-8000-000000000007",
      "name": "OpenAI Tier-1: Ambiguous Brief Clarification (gpt-4o-mini)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [
        1520,
        360
