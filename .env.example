# OpenAI API Configuration (Required for live LLM calls; falls back to deterministic simulator if empty)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
EXTRACTION_MODEL=gpt-4o-mini
PROPOSAL_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Business Policy Thresholds
MIN_BUDGET_USD=10000
HIGH_FIT_SCORE_THRESHOLD=75
LOW_FIT_SCORE_THRESHOLD=75

# Vector Store & Persistence
CHROMA_PERSIST_DIR=./storage/vector_db
KNOWLEDGE_BASE_PATH=./data/knowledge_base.json

# n8n & Webhook Integration
N8N_WEBHOOK_URL=http://n8n:5678/webhook/rfp-ingest
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_secret_password
APP_BASE_URL=http://app:8000
